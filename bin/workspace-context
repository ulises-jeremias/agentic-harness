#!/usr/bin/env bash
# workspace-context — delegates to agent-toolkit workspace.
#
# All subcommands are now handled by agent-toolkit workspace:
#   context (default)   → agent-toolkit workspace context
#   load <pack.yaml>    → agent-toolkit workspace load <pack.yaml>
#   load --profile <n>  → agent-toolkit workspace load --profile <n>
#   profiles            → agent-toolkit workspace profiles
#   personas            → agent-toolkit workspace personas
#   use-persona <name>  → agent-toolkit workspace use-persona <name>
#   handoff <name>      → agent-toolkit workspace handoff <name>
#   history [count]     → agent-toolkit workspace history [count]
#   validate [surface]  → agent-toolkit workspace validate [surface]
#
# Install: uvx agent-toolkit-cli  or  pip install agent-toolkit-cli

set -euo pipefail

if ! command -v agent-toolkit &>/dev/null; then
  printf '\033[1;31m[workspace-context] error:\033[0m agent-toolkit not found.\n' >&2
  echo "" >&2
  echo "Install it:" >&2
  echo "  uvx agent-toolkit-cli            # one-shot, no install" >&2
  echo "  pip install agent-toolkit-cli    # permanent install" >&2
  exit 1
fi

cmd="${1:-context}"
shift || true

case "${cmd}" in
  snapshot|context|"")
    exec agent-toolkit workspace context "$@"
    ;;
  load)
    exec agent-toolkit workspace load "$@"
    ;;
  profiles)
    exec agent-toolkit workspace profiles "$@"
    ;;
  personas)
    exec agent-toolkit workspace personas "$@"
    ;;
  use-persona)
    exec agent-toolkit workspace use-persona "$@"
    ;;
  handoff)
    exec agent-toolkit workspace handoff "$@"
    ;;
  history)
    exec agent-toolkit workspace history "$@"
    ;;
  validate)
    exec agent-toolkit workspace validate "$@"
    ;;
  help|--help|-h)
    exec agent-toolkit workspace --help
    ;;
  *)
    printf 'Unknown command: %s\n' "${cmd}" >&2
    exec agent-toolkit workspace --help
    ;;
esac
